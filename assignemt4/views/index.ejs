<!DOCTYPE html>
<html>
    <head> 
        <meta charset="UTF-8"/>
        <title>The Timeline</title>
    </head>
    <body>
        <h1>The Timeline</h1>
        <form action="/posts" method="POST">
            <textarea name="post" rows="5" cols="40"
            placeholder="Write your post.here"></textarea>
            <br />
            <button type="submit">Post</button>
        </form>
        <hr />
        <% posts.forEach(p => { %>
        <div style="margin-bottom: 20px">
            <small><%=p.createdAt ? p.createdAt.toDateString() : 'Unknown' %></small>
        <p><%= p.post %></p>
    <a href="/posts/<%= p._id %>">See more</a>
        </div>
    <% })%>
    </body>
    </html>